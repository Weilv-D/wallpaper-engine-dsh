{
  "name": "wallpaper-engine-dsh",
  "version": "0.1.9",
  "description": "Wallpaper Engine library as the DSH web GUI background — video/web/still wallpapers, rotation lists, search, resource monitor, bilingual UI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Weilv-D/wallpaper-engine-dsh.git"
  },
  "bugs": "https://github.com/Weilv-D/wallpaper-engine-dsh/issues",
  "homepage": "https://github.com/Weilv-D/wallpaper-engine-dsh#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "wallpaper",
    "wallpaper-engine",
    "background",
    "theme"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/core.js",
    "lib/index.js",
    "lib/client.js",
    "lib/types/index.d.ts",
    "lib/types/client.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "verify": "node scripts/verify-client.mjs",
    "test": "node --test test/core.test.mjs test/host.test.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm run test && npm run build && npm run verify",
    "release": "npm version patch -m \"chore: release v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"chore: release v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"chore: release v%s\" && git push --follow-tags"
  },
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
